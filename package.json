{
  "name": "reborn",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=./apps/* --continue",
    "dev:web": "turbo run dev --filter=reborn-back-office",
    "dev:mobile": "turbo run dev --filter=reborn-mobile-app-v2",
    "dev:api": "turbo run start:dev --filter=reborn-api",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.2",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=18",
    "pnpm": ">=11.25.0"
  }
}
