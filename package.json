{
  "name": "reborn",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=./apps/* --continue",
    "dev:web": "turbo run dev --filter=reborn-back-office",
    "dev:mobile": "turbo run dev --filter=reborn-mobile-app",
    "dev:api": "turbo run start:dev --filter=reborn-api",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "pnpm run check:shared-deps && turbo run check-types",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "dev:landing": "turbo run dev --filter=reborn-landing",
    "check:expo": "node ./scripts/mjs/check-expo.mjs",
    "check:shared-deps": "node ./scripts/mjs/sync-shared-deps.mjs"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.5",
    "prettier": "3.9.6",
    "turbo": "^2.11.2",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11.25.0"
  },
  "dependencies": {
    "expo": "58.0.17",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-css-interop": "0.2.7",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  }
}
