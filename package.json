{
  "name": "reborn",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter reborn-back-office dev",
    "dev:mobile": "pnpm --filter reborn-mobile-app-v2 dev",
    "dev:api": "pnpm --filter reborn-api start:dev",
    "build:web": "pnpm --filter reborn-back-office build",
    "build:api": "pnpm --filter reborn-api build",
    "lint:web": "pnpm --filter reborn-back-office lint",
    "lint:api": "pnpm --filter reborn-api lint"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=18"
  }
}
