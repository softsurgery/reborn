generator client {
  provider = "prisma-client-js"
}

generator typescriptInterfaces {
  provider = "prisma-generator-typescript-interfaces"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  firstName     String?
  lastName      String?
  dateOfBirth   DateTime?
  isActive      Boolean?
  password      String?
  username      String?   @unique
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  roleId        String?
  role          Role?     @relation(fields: [roleId], references: [id])
  appUsers      AppUser[]
  isApproved    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  deletedAt     DateTime?
}

model AppUser {
  id        Int       @id @default(autoincrement())
  userId    String
  regionId  Int
  region    Region    @relation(fields: [regionId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
}

model Role {
  id          String           @id @default(cuid())
  label       String
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  deletedAt   DateTime?
}

model Permission {
  id          String           @id
  label       String           @unique()
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  deletedAt   DateTime?
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  deletedAt    DateTime?
}

model DeviceInfo {
  id           Int        @id @default(autoincrement())
  platform     String?
  model        String
  version      String?
  manufacturer String?
  feedbacks    Feedback[]
  bugs         Bug[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  deletedAt    DateTime?
}

model Feedback {
  id        Int              @id @default(autoincrement())
  message   String
  rating    Int
  category  FeedbackCategory
  deviceId  Int?
  device    DeviceInfo?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt
  deletedAt DateTime?
}

model Bug {
  id          Int         @id @default(autoincrement())
  title       String
  description String
  category    BugCategory
  deviceId    Int?
  device      DeviceInfo? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt
  deletedAt   DateTime?
}

model Region {
  id        Int       @id @default(autoincrement())
  label     String
  AppUser   AppUser[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  deletedAt DateTime?
}

enum FeedbackCategory {
  FeatureRequest
  GeneralFeedback
  Other
}

enum BugCategory {
  Crash
  UiIssue
  Performance
  FeatureNotWorking
  Other
}
