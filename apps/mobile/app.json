{
  "expo": {
    "name": "reborn-mobile-app",
    "slug": "reborn-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "assets/images/reborn.png",
    "scheme": "rebornmobileapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "assets/images/reborn.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "reborn-mobile-app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.softsurgery.rebornmobileappv2"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-font",
      "react-native-localize",
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": true,
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dd8ee916-6009-41c7-b357-70743a33ebda"
      }
    }
  }
}