{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2023",
    "strictNullChecks": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "outDir": "./dist",
    "strict": false,
    "strictPropertyInitialization": false,
    "noEmit": true,
    "paths": {
      "src/*": [
        "../../apps/api/src/*"
      ],
      "@/*": [
        "../../apps/api/src/*"
      ],
      "nsa-auth/*": [
        "../nsa-auth/src/*"
      ],
      "nsa-chat/*": [
        "../nsa-chat/src/*"
      ],
      "nsa-configurations/*": [
        "../nsa-configurations/src/*"
      ],
      "nsa-helpers/*": [
        "../nsa-helpers/src/*"
      ],
      "nsa-logger/*": [
        "../nsa-logger/src/*"
      ],
      "nsa-mail/*": [
        "../nsa-mail/src/*"
      ],
      "nsa-notifications/*": [
        "../nsa-notifications/src/*"
      ],
      "nsa-reference-types/*": [
        "../nsa-reference-types/src/*"
      ],
      "nsa-sessions/*": [
        "../nsa-sessions/src/*"
      ],
      "nsa-storage/*": [
        "../nsa-storage/src/*"
      ],
      "nsa-tasks/*": [
        "../nsa-tasks/src/*"
      ],
      "nsa-templates/*": [
        "../nsa-templates/src/*"
      ],
      "nsa-workflows/*": [
        "../nsa-workflows/src/*"
      ],
      "nsa-auth": [
        "../nsa-auth/src/index.ts"
      ],
      "nsa-chat": [
        "../nsa-chat/src/index.ts"
      ],
      "nsa-configurations": [
        "../nsa-configurations/src/index.ts"
      ],
      "nsa-helpers": [
        "../nsa-helpers/src/index.ts"
      ],
      "nsa-logger": [
        "../nsa-logger/src/index.ts"
      ],
      "nsa-mail": [
        "../nsa-mail/src/index.ts"
      ],
      "nsa-notifications": [
        "../nsa-notifications/src/index.ts"
      ],
      "nsa-reference-types": [
        "../nsa-reference-types/src/index.ts"
      ],
      "nsa-sessions": [
        "../nsa-sessions/src/index.ts"
      ],
      "nsa-storage": [
        "../nsa-storage/src/index.ts"
      ],
      "nsa-tasks": [
        "../nsa-tasks/src/index.ts"
      ],
      "nsa-templates": [
        "../nsa-templates/src/index.ts"
      ],
      "nsa-workflows": [
        "../nsa-workflows/src/index.ts"
      ],
      "nsa-database": [
        "../nsa-database/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
