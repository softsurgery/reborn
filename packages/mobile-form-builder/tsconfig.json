{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "nativewind",
    "declaration": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@reborn/lib": [
        "../lib/src/index.ts"
      ],
      "@reborn/lib/*": [
        "../lib/src/*"
      ],
      "@reborn/mobile-ui": [
        "../mobile-ui/src/index.ts"
      ],
      "@reborn/mobile-ui/*": [
        "../mobile-ui/src/*"
      ],
      "@reborn/mobile-components": [
        "../mobile-components/src/index.ts"
      ],
      "@reborn/mobile-components/*": [
        "../mobile-components/src/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "src/nativewind-env.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
